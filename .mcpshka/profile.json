{
  "schema": "mcpshka.project-profile/v1",
  "name": "go2rtc-webos-pip",
  "description": "Go-native sealed tests, Go IPK packaging and independent Node webOS compatibility tests",
  "match": {
    "markers": [
      "go.mod"
    ]
  },
  "workflows": {
    "test": {
      "command": "go",
      "args": [
        "test",
        "-p",
        "1",
        "-count=1",
        "-timeout",
        "4m",
        "./internal/cameracaps",
        "./internal/camerametrics",
        "./internal/webospip",
        "./pkg/onvif",
        "./internal/streams",
        "./pkg/core",
        "./pkg/rtsp",
        "./pkg/webrtc",
        "./www",
        "./webos/ipk",
        "./webos/tests"
      ],
      "timeout_seconds": 2700,
      "output_limit_bytes": 8388608
    },
    "build": {
      "command": "go",
      "args": [
        "build",
        "-p",
        "1",
        "-buildvcs=false",
        "./..."
      ],
      "timeout_seconds": 1800,
      "output_limit_bytes": 8388608
    },
    "sidecar": {
      "command": "go",
      "args": [
        "build",
        "-p",
        "1",
        "-trimpath",
        "-buildvcs=false",
        "-o",
        "out/go2rtc-webos-ptz012",
        "."
      ],
      "timeout_seconds": 1800,
      "output_limit_bytes": 2097152,
      "artifacts": [
        "out/go2rtc-webos-ptz012"
      ]
    },
    "lint": {
      "command": "go",
      "args": [
        "test",
        "-p",
        "1",
        "-count=1",
        "-timeout",
        "3m",
        "./webos/ipk",
        "./webos/tests"
      ],
      "timeout_seconds": 300,
      "output_limit_bytes": 2097152
    },
    "package": {
      "command": "go",
      "args": [
        "run",
        "./webos/cmd/ipk"
      ],
      "timeout_seconds": 600,
      "output_limit_bytes": 2097152,
      "artifacts": [
        "out/webos/go2rtc-webos-pip-0.1.18.ipk"
      ]
    }
  }
}
